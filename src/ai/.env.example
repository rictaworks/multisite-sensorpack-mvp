# src/ai/.env.example
#
# 実際の値は .env（gitignore対象）またはデプロイ先プラットフォーム（Railway等）の
# 環境変数に設定すること。このファイル自体に実際のシークレットを書かない。
#
# 使い方: cp .env.example .env

# 実行環境。development / test / production のいずれか。
# 未設定・不明な値の場合はfail closedでproduction扱いになる
# （.claude/rules/environment.md）。
APP_ENV=development

# LLM APIキー（例: OpenAI）。ひな形の段階では未設定でも起動可能。
OPENAI_API_KEY=

# LangSmith観測（requirements.md F7: LangSmithで観測）。
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multisite-sensorpack-mvp
