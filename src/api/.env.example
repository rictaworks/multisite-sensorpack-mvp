# このファイルをコピーして .env を作成し、値を設定する。
#   cp .env.example .env
# .env はGit管理対象外(.gitignore済み)。実際の値は絶対にコミットしないこと。

# Railsの実行環境。単一の情報源として環境判定に使用する。
# development(既定) / test / production のいずれか。
RAILS_ENV=development

# ActiveRecordの最大コネクション数(任意)。
RAILS_MAX_THREADS=5

# 本番環境(production)でのみ使用。PostgreSQLへの接続文字列。
# 例: postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
# 開発・テスト環境ではSQLiteを使用するため設定不要。
DATABASE_URL=

# Issue #7: GoogleログインのOAuthクライアントID。
# Next.js側で取得したIDトークン(JWT)のaud claim検証に使用する(Google Cloud Consoleで発行)。
# 本番(production)ではこの値が未設定の場合、起動時に例外を送出する(fail fast)。
GOOGLE_OAUTH_CLIENT_ID=

# requirements.md 1.3: reCAPTCHAのシークレットキー(Google reCAPTCHA管理画面で発行)。
# ログイン導線(POST /auth/session)とクレームコード発行導線(POST /api/v1/claim-codes)の
# 両方でGoogle siteverify APIの呼び出しに使用する(app/services/recaptcha_verifier.rb)。
# サイトキー(公開値)はNext.js側のNEXT_PUBLIC_RECAPTCHA_SITE_KEYで、こちらは非公開のシークレット。
# production環境ではこの値が未設定の場合、起動時に例外を送出する(fail fast、
# config/initializers/recaptcha.rb)。開発・テスト環境では未設定でよく、
# RecaptchaVerifier::TEST_SUCCESS_TOKEN による検証に切り替わる。
RECAPTCHA_SECRET_KEY=

# Rails標準の暗号化cookie(Googleログインのセッション)の鍵導出に使う。
# 本番では RAILS_MASTER_KEY(config/credentials.yml.encの復号鍵)または SECRET_KEY_BASE の
# いずれかを必ずプラットフォームの環境変数として設定する。未設定だとセッションcookieを
# 発行・復号できず、Googleログインが成立しない。値は絶対にコミットしない。
# RAILS_MASTER_KEY=
# SECRET_KEY_BASE=

# Issue #14: F7 AI日次サマリー。RailsからIssue #13のFastAPI(internal-ai)を呼び出すための設定。
# AI_SERVICE_BASE_URLはFastAPIサービスのベースURL(例: http://localhost:8001)。
# INTERNAL_AI_API_KEYはsrc/ai/.env.exampleの同名変数と共通の値を設定し、
# X-Internal-Api-Keyヘッダで照合する(server-to-server限定、未設定時はfail closedで拒否する)。
AI_SERVICE_BASE_URL=
INTERNAL_AI_API_KEY=

# Issue #16: F9 開発者向け管理画面(BASIC認証)のユーザー名/パスワード。
# 一般消費者向けGoogleログインとは別物の認証情報であり、コードにハードコードしない。
# production環境ではこの値が未設定の場合、起動時に例外を送出する(fail fast、
# config/initializers/admin_basic_auth.rb)。開発・テストでも未設定の場合はfail closedで
# /admin配下への全アクセスを拒否する(app/controllers/admin/base_controller.rb)。
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
