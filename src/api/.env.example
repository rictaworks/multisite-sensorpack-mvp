# このファイルをコピーして .env を作成し、値を設定する。
#   cp .env.example .env
# .env はGit管理対象外(.gitignore済み)。実際の値は絶対にコミットしないこと。

# Railsの実行環境。単一の情報源として環境判定に使用する。
# development(既定) / test / production のいずれか。
RAILS_ENV=development

# ActiveRecordの最大コネクション数(任意)。
RAILS_MAX_THREADS=5

# 本番環境(production)でのみ使用。PostgreSQLへの接続文字列。
# 例: postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
# 開発・テスト環境ではSQLiteを使用するため設定不要。
DATABASE_URL=
