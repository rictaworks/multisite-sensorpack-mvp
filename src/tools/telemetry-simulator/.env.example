# src/tools/telemetry-simulator 用の環境変数サンプル。
# 実際の値は`.env`にコピーして設定する(.envはコミットしない、CLAUDE.md準拠)。

# 必須: POST /api/v1/devices/claim で発行された生のデバイストークン
TELEMETRY_DEVICE_TOKEN=

# 任意: Rails APIのベースURL(既定: http://localhost:3000/api/v1)
TELEMETRY_API_BASE_URL=http://localhost:3000/api/v1

# 任意: 送信間隔ミリ秒(既定: 60000 = requirements.md F2手順1の既定送信間隔60秒と一致)
TELEMETRY_INTERVAL_MS=60000

# 任意: 開始seq番号(既定: 1)
TELEMETRY_START_SEQ=1

# 任意: 送信件数の上限(既定: 無制限。Ctrl+Cで停止)
TELEMETRY_ITERATIONS=

# 任意: none / out_of_range / duplicate (requirements.md 1.9 Eカテゴリの手動確認用)
TELEMETRY_ANOMALY_MODE=none
