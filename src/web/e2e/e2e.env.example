# Playwright E2E(Issue #25)がローカルで `npm run test:e2e` を実行する際に読み込む環境変数。
# src/web/ ディレクトリで実行すること:
#   cp e2e/e2e.env.example .env.e2e
# .env.e2e はGit管理対象外(.gitignoreの `.env.*` パターンで除外される)。
# 実際の値をコミットしないこと。
#
# ここに列挙する値はすべて「非シークレット」であり、.claude/rules/testing.md
# 「テストに必要な値は.envを参照する。値をテストコードにハードコードしない」を
# 満たすために.envファイル経由で渡す。詳細はsrc/web/e2e/README.mdを参照。
#
# ファイル名を `.env.e2e.example`(先頭ドット)ではなく `e2e.env.example` に
# しているのは、リポジトリルートの.gitignoreが `.env.*` を一括除外しており
# (`!.env.example` の1本だけを例外扱いする設計)、先頭ドット付きの新規テン
# プレートファイルを増やすとGit管理下に置けなくなるため。

# Next.jsの実行環境。playwright.config.tsはこの値を上書きして2つのサーバー
# (development用/production用)を別ポートで起動する(.claude/rules/environment.md
# の「開発環境の自動認証は本番で絶対到達不可」をE2Eで直接検証するため)。
# ここでの値自体は使われない(参考のため残置)。
APP_ENV=development

# Google Identity Services用のOAuthクライアントID。実際のGoogleログイン完了
# (本物のGoogleテストアカウントでのサインイン)はこのリポジトリのE2Eスコープ外
# (作業指示より: 検証対象は「開発環境自動認証→ダッシュボード表示」)。ログイン
# 画面の描画・reCAPTCHA通過後にボタンが有効化されることの確認にのみ使うため、
# 実在しないダミー値で構わない(Googleへの実際のサインインリクエストは行わない)。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-e2eplaceholder.apps.googleusercontent.com

# Google公式の「常に検証を通過するテスト用reCAPTCHA v2キー」。
# https://developers.google.com/recaptcha/docs/faq
# ("Is there a way to always get passing/failing validation responses for
# testing?") に公開されている、あらゆるドメインで利用可能な非シークレットの
# テスト用キーペア。本番のキーではない。
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# バックエンド(Rails API)は本Issueのスコープ外で未結線のため、意図的に
# 到達不能なローカルポートを指定する。ログイン画面はセッション確認に失敗
# しても例外を握りつぶさずログ出力のうえ描画を継続する設計(lib/auth/
# requireSession.ts, app/[locale]/(auth)/login/page.tsx)であることを確認済み。
BACKEND_API_BASE_URL=http://127.0.0.1:9

# reCAPTCHAのシークレットキー(Google公式テストペアの片方)。Next.js側では
# 使用しない(サーバー側検証はRailsの責務)が、.env.exampleとの対応を明確に
# するため参考記載のみ。
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
