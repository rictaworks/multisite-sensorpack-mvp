# このファイルをコピーして .env を作成し、値を設定する。
#   cp .env.example .env
# .env はGit管理対象外(.gitignore済み)。実際の値は絶対にコミットしないこと。

# Next.jsの実行環境。単一の情報源として環境判定に使用する
# (.claude/rules/environment.md)。development(既定) / test / production の
# いずれか。未設定・不明な値は本番として扱う(fail closed)ため、Vercel等の
# デプロイ先では明示的に production を設定すること。
APP_ENV=development

# --- Googleログイン(Issue #17, requirements.md 1.3節) ---

# Google Cloud ConsoleのOAuthクライアントID。ブラウザ側で使う「Sign in with
# Google」ボタン(@react-oauth/google)に渡す値で、公開して問題ない
# (クライアントシークレットは一切使用しない。IDトークンの署名検証は
# RailsがGoogleの公開鍵で行う)。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# reCAPTCHA v2(チェックボックス)のサイトキー。公開して問題ない値。
# シークレットキーによる検証はRails側(POST /auth/session)で行うため、
# Next.js側ではシークレットキーを保持しない。
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- バックエンド連携(.claude/rules/deploy.md: バックエンドのドメインは隠蔽する) ---

# Rails API(本番は無料Railway、不可時のみRender)の実際のオリジン。
# サーバー側(lib/api/backendBaseUrl.ts を経由する lib/auth/backendSession.ts と
# lib/api/backendProxy.ts)からのみ参照し、ブラウザには一切露出しない
# (NEXT_PUBLIC_プレフィックスを付けないこと)。
#
# ブラウザは同一オリジンの相対パスだけを叩き、Next.jsがサーバー側でここへ転送する。
#   /auth/session … app/api/auth/session/route.ts
#   /api/v1/*     … app/api/v1/[...path]/route.ts (Issue #53 A-4)
# 未設定の場合、これらの経路は502を返す(既定のホストへフォールバックしない)。
BACKEND_API_BASE_URL=http://localhost:3001
